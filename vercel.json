{
  "version": 2,
  "builds": [
    {
      "src": "client-with-jwt/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/client-with-jwt/$1" }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
